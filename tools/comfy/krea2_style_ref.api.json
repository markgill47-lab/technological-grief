{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Krea2 diffusion model" },
    "inputs": { "unet_name": "krea2_turbo_int8_convrot.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL text encoder (krea2)" },
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Style LoRA (dropped when --lora none)" },
    "inputs": { "model": ["1", 0], "lora_name": "krea2_style_reference.safetensors", "strength_model": 1.0 }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "Style reference 1" },
    "inputs": { "image": "ref1.png" }
  },
  "8": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Prompt + reference images" },
    "inputs": { "clip": ["2", 0], "prompt": "", "vae": ["3", 0], "image1": ["5", 0] }
  },
  "9": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "Reference latent method" },
    "inputs": { "conditioning": ["8", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "10": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (zeroed, trained uncond at cfg 1)" },
    "inputs": { "conditioning": ["9", 0] }
  },
  "11": {
    "class_type": "ModelSamplingFlux",
    "_meta": { "title": "Sampling shift" },
    "inputs": { "model": ["4", 0], "max_shift": 1.15, "base_shift": 0.5, "width": 896, "height": 1120 }
  },
  "12": {
    "class_type": "CFGGuider",
    "inputs": { "model": ["11", 0], "positive": ["9", 0], "negative": ["10", 0], "cfg": 1.0 }
  },
  "13": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "14": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["11", 0], "scheduler": "simple", "steps": 8, "denoise": 1.0 }
  },
  "15": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
  "16": { "class_type": "EmptyLatentImage", "inputs": { "width": 896, "height": 1120, "batch_size": 1 } },
  "17": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["15", 0],
      "guider": ["12", 0],
      "sampler": ["13", 0],
      "sigmas": ["14", 0],
      "latent_image": ["16", 0]
    }
  },
  "18": { "class_type": "VAEDecode", "inputs": { "samples": ["17", 0], "vae": ["3", 0] } },
  "19": { "class_type": "SaveImage", "inputs": { "images": ["18", 0], "filename_prefix": "grief/krea2" } }
}
