# Serverless proxy only. Server-side, NEVER VITE_-prefixed: that prefix is
# what inlines a value into the client bundle, which is how v1's design
# leaked the key. check-bundle.mjs fails the build if one appears.
#
# Leave this unset and the app still works: the Conversation path hides
# itself and the Quick path — which makes no network calls at all — is the
# only diagnostic offered. That is a supported deployment, not a broken one.
ANTHROPIC_API_KEY=

# Optional. Empty disables accuracy collection entirely.
# When set, one coarse, aggregate-only POST per opted-in diagnosis:
#   { stage, domain, path, confidence, accurate, gapSign }
# Never free text, never survey answers, never a session identifier.
VITE_METRICS_ENDPOINT=
